/*
 * A program that assigns several integer variables and prints them with the appropriate format specifier
*/

#include <cstdio>

int main() {
  unsigned short a = 0b10101010;
  printf("%hu\n", a);
  int b = 0123;
  printf("%d\n",b);
  unsigned long long d = 0xFFFFFFFFFFFF;
  printf("%llu\n", d);

  // Floating types
  /** float - Single precision - F
   * double - double precision - l
   * long double - extended precision - L
   */

  float ab = 0.1F;
  double g = 0.2;
  long double gg = 0.3L;
  double plancks_constant = 6.62607004e-34; //No space between significand and suffix

  double an = 6.0221409e23;
  printf("Avogadro's number: %le %lf %lg\n", an, an,an);

  float hp = 9.75;
  printf("Hogwarts' Platform: %e %f %g\n", hp, hp, hp);
